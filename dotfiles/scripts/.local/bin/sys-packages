#!/usr/bin/env bash
# ==============================================================================
# SYS-PACKAGES: Gestor interactivo de paquetes Pacman y AUR
# Estética: Ecosistema Spider-Man (Rojo Neón y Negro)
# ==============================================================================

# Cargar variables de colores del tema activo
source "$HOME/.config/theme/active.sh" 2>/dev/null
export FZF_DEFAULT_OPTS="
    --layout=reverse
    ${FZF_THEME:---color=\"bg+:#16171f,bg:#0c0d12,spinner:#ff3b5c,hl:#00e5ff\" --color=\"fg:#f8f9fa,header:#ff3b5c,info:#d500f9,pointer:#00e676\" --color=\"marker:#e60026,fg+:#ffffff,prompt:#e60026,hl+:#00e5ff,border:#ff1e43\"}
    --border=rounded --padding=1,2 --margin=2%
    --prompt='  ❯ ' --pointer='' --marker='󰄬'
"

RED='\033[1;31m'
GREEN='\033[1;32m'
BLUE='\033[1;34m'
YELLOW='\033[1;33m'
WHITE='\033[1;37m'
NC='\033[0m'
BOLD='\033[1m'

msg()      { echo -e "${BLUE}::${NC} $1"; }
msg_ok()   { echo -e "${GREEN}==>${NC} $1"; }
msg_err()  { echo -e "${RED}[ERROR]${NC} $1"; }
msg_warn() { echo -e "${YELLOW}[WARNING]${NC} $1"; }
msg_step() { echo -e "\n${RED}┌─[ $1 ]${NC} ${BOLD}$2${NC}\n${WHITE}└──────────────────────────────────────────────${NC}"; }

show_banner() {
    clear
    echo -e "${RED}"
    echo "  ██████╗  █████╗  ██████╗██╗  ██╗ █████╗  ██████╗ ███████╗███████╗"
    echo "  ██╔══██╗██╔══██╗██╔════╝██║ ██╔╝██╔══██╗██╔════╝ ██╔════╝██╔════╝"
    echo "  ██████╔╝███████║██║     █████╔╝ ███████║██║  ███╗█████╗  ███████╗"
    echo "  ██╔═══╝ ██╔══██║██║     ██╔═██╗ ██╔══██║██║   ██║██╔══╝  ╚════██║"
    echo "  ██║     ██║  ██║╚██████╗██║  ██╗██║  ██║╚██████╔╝███████╗███████║"
    echo "  ╚═╝     ╚═╝  ╚═╝ ╚═════╝╚═╝  ╚═╝╚═╝  ╚═╝ ╚═════╝ ╚══════╝╚══════╝"
    echo -e "${NC}"
    echo -e "      ${BOLD}󰏖  GESTOR DE PAQUETES SPIDER-MAN  󰏖${NC}"
    echo -e "${WHITE}  ─────────────────────────────────────────────────────────${NC}"
    echo ""
}

pause() {
    echo ""
    read -r -p "  Presiona [Enter] para continuar..."
}

menu_principal() {
    while true; do
        show_banner
        
        OPCION=$(echo -e "1. 󰏗 Explorar e Instalar (Repos Oficiales)\n2. 󰣇 Buscar e Instalar (AUR)\n3. 󰍉 Ver Paquetes Instalados\n4. 󰆴 Desinstalar Paquetes\n5. 󰩈 Salir" | fzf --prompt="Elige una opción ❯ " --border-label=" Menú Principal " --header="Usa las flechas y presiona Enter")

        case "$OPCION" in
            *1.*)
                instalar_oficiales
                ;;
            *2.*)
                instalar_aur
                ;;
            *3.*)
                ver_instalados
                ;;
            *4.*)
                desinstalar_paquetes
                ;;
            *5.*)
                clear
                msg_ok "Saliendo del gestor de paquetes."
                exit 0
                ;;
            *)
                ;;
        esac
    done
}

instalar_oficiales() {
    msg_step "Repos Oficiales" "Selecciona paquetes con TAB y presiona ENTER para instalar"
    
    # pacman -Slq obtiene todos los paquetes de repos oficiales rápido
    SELECCION=$(pacman -Slq | sort | uniq | fzf --multi --preview 'pacman -Si {} 2>/dev/null || echo "No hay detalles disponibles"' --preview-window=right:60%:wrap --prompt="Buscar paquete ❯ " --border-label=" Repositorios Oficiales (Pacman) ")

    if [ -n "$SELECCION" ]; then
        echo -e "\n${BLUE}Paquetes seleccionados:${NC}"
        echo "$SELECCION" | sed 's/^/  - /'
        echo ""
        read -r -p "  ¿Deseas instalar estos paquetes? [S/n]: " confirm
        if [[ ! "$confirm" =~ ^[nN]$ ]]; then
            PAQUETES=$(echo "$SELECCION" | tr '\n' ' ')
            # shellcheck disable=SC2086
            sudo pacman -S $PAQUETES
            msg_ok "Operación finalizada."
        else
            msg_warn "Instalación cancelada."
        fi
    else
        msg "No se seleccionó ningún paquete."
    fi
    pause
}

instalar_aur() {
    msg_step "AUR (Paru)" "Búsqueda interactiva en AUR"
    echo -e "  ${WHITE}Introduce un término para buscar en AUR:${NC}"
    read -r -p "  ❯ " TERMINO
    
    if [ -z "$TERMINO" ]; then
        msg_warn "Término de búsqueda vacío."
        pause
        return
    fi
    
    msg "Buscando '$TERMINO' en AUR..."
    # paru -Ssq busca rápido y devuelve solo nombres. Limitamos un poco para no saturar
    RESULTADOS=$(paru -Ssq "$TERMINO" 2>/dev/null)
    
    if [ -z "$RESULTADOS" ]; then
        msg_err "No se encontraron resultados para '$TERMINO'."
        pause
        return
    fi

    SELECCION=$(echo "$RESULTADOS" | fzf --multi --preview 'paru -Si {} 2>/dev/null || echo "No hay detalles disponibles"' --preview-window=right:60%:wrap --prompt="Seleccionar (TAB) ❯ " --border-label=" Resultados en AUR para '$TERMINO' ")

    if [ -n "$SELECCION" ]; then
        echo -e "\n${BLUE}Paquetes seleccionados para instalar desde AUR:${NC}"
        echo "$SELECCION" | sed 's/^/  - /'
        echo ""
        read -r -p "  ¿Deseas instalar estos paquetes? [S/n]: " confirm
        if [[ ! "$confirm" =~ ^[nN]$ ]]; then
            PAQUETES=$(echo "$SELECCION" | tr '\n' ' ')
            # shellcheck disable=SC2086
            paru -S $PAQUETES
            msg_ok "Operación finalizada."
        else
            msg_warn "Instalación cancelada."
        fi
    else
        msg "No se seleccionó ningún paquete."
    fi
    pause
}

ver_instalados() {
    msg_step "Paquetes Instalados" "Visualizando todos los paquetes instalados en el sistema"
    
    # pacman -Qq lista todo lo instalado
    # shellcheck disable=SC2034
    SELECCION=$(pacman -Qq | fzf --preview 'pacman -Qi {} 2>/dev/null' --preview-window=right:60%:wrap --prompt="Buscar instalado ❯ " --border-label=" Explorador de Paquetes Instalados ")
    
    # No requerimos acciones con SELECCION aquí, es solo para visualizar
}

desinstalar_paquetes() {
    msg_step "Desinstalar" "Selecciona paquetes con TAB y presiona ENTER para eliminarlos"
    
    # pacman -Qqe lista paquetes instalados explícitamente para evitar romper dependencias base accidentalmente
    SELECCION=$(pacman -Qq | fzf --multi --preview 'pacman -Qi {} 2>/dev/null' --preview-window=right:60%:wrap --prompt="Seleccionar para desinstalar ❯ " --border-label=" Desinstalador de Paquetes ")

    if [ -n "$SELECCION" ]; then
        echo -e "\n${RED}Paquetes seleccionados para ELIMINAR:${NC}"
        echo "$SELECCION" | sed 's/^/  - /'
        echo ""
        msg_warn "¡ATENCIÓN! Se eliminarán estos paquetes y sus dependencias no utilizadas (si es posible)."
        read -r -p "  ¿Estás seguro de continuar? [S/n]: " confirm
        if [[ ! "$confirm" =~ ^[nN]$ ]]; then
            PAQUETES=$(echo "$SELECCION" | tr '\n' ' ')
            # shellcheck disable=SC2086
            sudo pacman -Rns $PAQUETES
            msg_ok "Operación finalizada."
        else
            msg_warn "Desinstalación cancelada."
        fi
    else
        msg "No se seleccionó ningún paquete."
    fi
    pause
}

# Inicio del script
menu_principal
