#!/usr/bin/env bash
# ==============================================================================
# SYS-ALIASES: Visor e Copiador Interactivo de Alias de Zsh
# Estética: Ecosistema Spider-Man Premium
# ==============================================================================

# Cargar variables de colores del tema activo
# shellcheck source=/dev/null
source "$HOME/.config/theme/active.sh" 2>/dev/null
export FZF_DEFAULT_OPTS="
    --layout=reverse
    ${FZF_THEME:---color=\"bg+:#16171f,bg:#0c0d12,spinner:#ff3b5c,hl:#00e5ff\" --color=\"fg:#f8f9fa,header:#ff3b5c,info:#d500f9,pointer:#00e676\" --color=\"marker:#e60026,fg+:#ffffff,prompt:#e60026,hl+:#00e5ff,border:#ff1e43\"}
    --border=rounded --padding=1,2 --margin=2%
    --prompt='  ❯ ' --pointer='' --marker='󰄬'
"

# Buscar primero en la ruta de producción (~/.config/zsh/aliases.zsh)
ALIASES_FILE="$HOME/.config/zsh/aliases.zsh"

# Si no existe en la ruta de producción, intentar resolver dinámicamente relativa al script
if [[ ! -f "$ALIASES_FILE" ]]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
    # Mapeo al repositorio: scripts/.local/bin -> subir 3 niveles a la raíz del stow pack
    REPO_DIR="$(cd "$SCRIPT_DIR/../../.." &>/dev/null && pwd)"
    if [[ -d "$REPO_DIR/zsh/.config/zsh" ]]; then
        ALIASES_FILE="$REPO_DIR/zsh/.config/zsh/aliases.zsh"
    fi
fi

if [[ ! -f "$ALIASES_FILE" ]]; then
    echo -e "\033[1;31m[ERROR]\033[0m Fichero de alias no encontrado en: $ALIASES_FILE"
    read -n 1 -s -r -p "Presiona cualquier tecla para salir..."
    exit 1
fi

echo -e "\033[1;36mCargando alias del sistema...\033[0m"

# Parsear los alias y presentarlos en un FZF interactivo
grep -E "^alias " "$ALIASES_FILE" | awk -F'=' '{
    name = $1; gsub(/^alias /, "", name);
    cmd = $0; sub(/^alias [^=]*=/, "", cmd);
    # Quitar comillas del comando
    gsub(/^"|"$/, "", cmd);
    gsub(/^'\''|'\''$/, "", cmd);
    
    # Formato de salida
    printf "%s = %s\n", name, cmd;
}' \
| column -t -s '=' \
| fzf \
    --header="  ALIAS               COMANDO" \
    --bind "enter:execute(echo {} | awk '{print \$1}' | wl-copy)+abort" \
    --info=inline
