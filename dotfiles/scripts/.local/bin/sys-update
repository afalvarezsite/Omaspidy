#!/usr/bin/env bash
# ==============================================================================
# SYS-UPDATE: Actualizador Completo del Ecosistema Spider-Man
# Actualiza: sistema (paru), plugins Zinit, plugins LazyVim, zinit self-update
# Estética: Ecosistema Spider-Man (Rojo Neón y Negro)
# ==============================================================================

# Cargar variables de colores del tema activo
source "$HOME/.config/theme/active.sh" 2>/dev/null
export FZF_DEFAULT_OPTS="
    --layout=reverse
    ${FZF_THEME:---color=\"bg+:#16171f,bg:#0c0d12,spinner:#ff3b5c,hl:#00e5ff\" --color=\"fg:#f8f9fa,header:#ff3b5c,info:#d500f9,pointer:#00e676\" --color=\"marker:#e60026,fg+:#ffffff,prompt:#e60026,hl+:#00e5ff,border:#ff1e43\"}
    --border=rounded --padding=1,2 --margin=2%
    --prompt='  ❯ ' --pointer='' --marker='󰄬'
"

RED='\033[1;31m'
GREEN='\033[1;32m'
BLUE='\033[1;34m'
YELLOW='\033[1;33m'
WHITE='\033[1;37m'
NC='\033[0m'
BOLD='\033[1m'

msg()      { echo -e "${BLUE}::${NC} $1"; }
msg_ok()   { echo -e "${GREEN}==>${NC} $1"; }
msg_err()  { echo -e "${RED}[ERROR]${NC} $1"; }
msg_warn() { echo -e "${YELLOW}[WARNING]${NC} $1"; }
msg_step() { echo -e "\n${RED}┌─[ PASO $1 / $2 ]${NC} ${BOLD}$3${NC}\n${WHITE}└──────────────────────────────────────────────${NC}"; }

show_banner() {
    clear
    echo -e "${RED}"
    echo "  ██╗   ██╗██████╗ ██████╗  █████╗ ████████╗███████╗"
    echo "  ██║   ██║██╔══██╗██╔══██╗██╔══██╗╚══██╔══╝██╔════╝"
    echo "  ██║   ██║██████╔╝██║  ██║███████║   ██║   █████╗  "
    echo "  ██║   ██║██╔═══╝ ██║  ██║██╔══██║   ██║   ██╔══╝  "
    echo "  ╚██████╔╝██║     ██████╔╝██║  ██║   ██║   ███████╗"
    echo "   ╚═════╝ ╚═╝     ╚═════╝ ╚═╝  ╚═╝   ╚═╝   ╚══════╝"
    echo -e "${NC}"
    echo -e "      ${BOLD}󰚰  ACTUALIZADOR DE ECOSISTEMA  󰚰${NC}"
    echo -e "${WHITE}  ─────────────────────────────────────────────────────────${NC}"
    echo ""
}

# No ejecutar como root
if [ "$EUID" -eq 0 ]; then
    msg_err "No ejecutes este script como root."
    exit 1
fi

show_banner

# Resumen de lo que se va a hacer
echo -e "  ${WHITE}Este script realizará las siguientes actualizaciones:${NC}"
echo -e "  ${RED}1.${NC} Sistema Arch + AUR            ${BLUE}(paru -Syu)${NC}"
echo -e "  ${RED}2.${NC} Plugins de Zinit              ${BLUE}(zinit update --all)${NC}"
echo -e "  ${RED}3.${NC} Plugins de Neovim / LazyVim   ${BLUE}(nvim --headless)${NC}"
echo -e "  ${RED}4.${NC} Auto-actualización de Zinit   ${BLUE}(zinit self-update)${NC}"
echo -e "  ${RED}5.${NC} Limpieza de huérfanos         ${BLUE}(pacman -Qtdq | paru -Rns)${NC}"
echo ""

read -r -p "  ¿Iniciar actualización completa del ecosistema? [S/n]: " confirm
if [[ "$confirm" =~ ^[nN]$ ]]; then
    msg "Actualización cancelada."
    exit 0
fi

ERRORS=()
START_TIME=$(date +%s)

# ==============================================================================
# PASO 1: Sistema y AUR
# ==============================================================================
msg_step "1" "5" "Actualizando sistema y paquetes AUR..."
if command -v paru &>/dev/null; then
    PRE_SNAP_ID=""
    if command -v snapper &>/dev/null && sudo snapper -c root ls &>/dev/null; then
        msg "Creando pre-snapshot de BTRFS..."
        PRE_SNAP_ID=$(sudo snapper -c root create --type pre --print-number -d "Antes de sys-update: paru -Syu" 2>/dev/null || true)
    fi

    if paru -Syu --noconfirm; then
        msg_ok "Sistema actualizado."
    else
        msg_warn "Hubo advertencias al actualizar el sistema."
        ERRORS+=("paru -Syu tuvo errores")
    fi

    if [ -n "$PRE_SNAP_ID" ]; then
        msg "Creando post-snapshot de BTRFS..."
        sudo snapper -c root create --type post --pre-number "$PRE_SNAP_ID" -d "Después de sys-update: paru -Syu" &>/dev/null || true
    fi
else
    msg_err "paru no encontrado. Saltando actualización de sistema."
    ERRORS+=("paru no disponible")
fi

# ==============================================================================
# PASO 2: Plugins de Zinit
# ==============================================================================
msg_step "2" "5" "Actualizando plugins de Zinit..."
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
if [ -d "$ZINIT_HOME" ]; then
    # Ejecutar zinit update en un subshell de zsh sin sesión interactiva
    if zsh -c "
        source '${ZINIT_HOME}/zinit.zsh'
        zinit update --all --quiet 2>/dev/null
    " 2>/dev/null; then
        msg_ok "Plugins de Zinit actualizados."
    else
        msg_warn "Zinit update devolvió un error (puede ser normal si algún plugin no tiene cambios)."
    fi
else
    msg_warn "Zinit no encontrado en $ZINIT_HOME. Saltando."
    ERRORS+=("Zinit no instalado")
fi

# ==============================================================================
# PASO 3: Plugins de Neovim / LazyVim
# ==============================================================================
msg_step "3" "5" "Actualizando plugins de Neovim (LazyVim)..."
if command -v nvim &>/dev/null; then
    msg "Ejecutando LazyVim sync en modo headless (puede tardar unos momentos)..."
    if nvim --headless "+Lazy! sync" +qa 2>/dev/null; then
        msg_ok "Plugins de Neovim actualizados."
    else
        msg_warn "Neovim headless sync tuvo advertencias (puede ser normal si no hay cambios)."
    fi
else
    msg_warn "nvim no encontrado. Saltando actualización de plugins."
    ERRORS+=("Neovim no disponible")
fi

# ==============================================================================
# PASO 4: Auto-actualización de Zinit
# ==============================================================================
msg_step "4" "5" "Auto-actualizando el gestor de plugins Zinit..."
if [ -d "$ZINIT_HOME" ]; then
    if zsh -c "
        source '${ZINIT_HOME}/zinit.zsh'
        zinit self-update --quiet 2>/dev/null
    " 2>/dev/null; then
        msg_ok "Zinit actualizado."
    else
        msg_warn "Zinit self-update no disponible o sin cambios."
    fi
fi

# ==============================================================================
# PASO 5: Limpieza de huérfanos
# ==============================================================================
msg_step "5" "5" "Eliminando paquetes huérfanos residuales..."
ORPHANS=$(pacman -Qtdq 2>/dev/null || true)
if [ -n "$ORPHANS" ]; then
    ORPHAN_COUNT=$(echo "$ORPHANS" | wc -l)
    msg "Se encontraron $ORPHAN_COUNT paquete(s) huérfano(s):"
    echo "$ORPHANS" | while read -r pkg; do echo -e "  ${YELLOW}·${NC} $pkg"; done
    read -r -p "  ¿Eliminar todos los huérfanos? [S/n]: " del_confirm
    if [[ ! "$del_confirm" =~ ^[nN]$ ]]; then
        # shellcheck disable=SC2086
        sudo pacman -Rns --noconfirm $ORPHANS
        msg_ok "Paquetes huérfanos eliminados."
    else
        msg "Huérfanos omitidos."
    fi
else
    msg_ok "No hay paquetes huérfanos. El sistema está limpio."
fi

# ==============================================================================
# RESUMEN FINAL
# ==============================================================================
END_TIME=$(date +%s)
ELAPSED=$(( END_TIME - START_TIME ))
MINS=$(( ELAPSED / 60 ))
SECS=$(( ELAPSED % 60 ))

echo ""
echo -e "${RED}╔══════════════════════════════════════════════════════╗${NC}"
echo -e "${RED}║${NC}   ${BOLD}󰚰  ACTUALIZACIÓN DEL ECOSISTEMA COMPLETADA${NC}          ${RED}║${NC}"
echo -e "${RED}║${NC}   Tiempo total: ${WHITE}${MINS}m ${SECS}s${NC}                                 ${RED}║${NC}"

if [ ${#ERRORS[@]} -eq 0 ]; then
    echo -e "${RED}║${NC}   Estado:      ${GREEN}✓ Todo actualizado sin errores${NC}            ${RED}║${NC}"
else
    echo -e "${RED}║${NC}   Estado:      ${YELLOW}⚠ Completado con advertencias:${NC}            ${RED}║${NC}"
    for err in "${ERRORS[@]}"; do
        echo -e "${RED}║${NC}     ${YELLOW}·${NC} $err                                          ${RED}║${NC}"
    done
fi

echo -e "${RED}╚══════════════════════════════════════════════════════╝${NC}"
echo ""
