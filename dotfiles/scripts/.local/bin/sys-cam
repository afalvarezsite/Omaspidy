#!/usr/bin/env bash
# ==============================================================================
# SYS-CAM: Gestor, Grabador y Protector de Cámara Web (100% FZF)
# Estética: Ecosistema Spider-Man (Rojo Neón y Negro)
# ==============================================================================

# Cargar variables de colores del tema activo
source "$HOME/.config/theme/active.sh" 2>/dev/null
export FZF_DEFAULT_OPTS="
    --layout=reverse
    ${FZF_THEME:---color=\"bg+:#16171f,bg:#0c0d12,spinner:#ff3b5c,hl:#00e5ff\" --color=\"fg:#f8f9fa,header:#ff3b5c,info:#d500f9,pointer:#00e676\" --color=\"marker:#e60026,fg+:#ffffff,prompt:#e60026,hl+:#00e5ff,border:#ff1e43\"}
    --border=rounded --padding=1,2 --margin=2%
    --prompt='  ❯ ' --pointer='' --marker='󰄬'
"

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
WHITE='\033[1;37m'
CYAN='\033[1;36m'
NC='\033[0m'
BOLD='\033[1m'

CONFIG_FILE="$HOME/.config/sys-cam.conf"
OUTPUT_DIR="$HOME/Vídeos"

# Configuración por defecto
CAM_RES="1280x720"
CAM_FPS="30"
RECORD_AUDIO="Sí"
MIRROR_MODE="No"

# Cargar configuración persistente si existe
if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
fi

show_banner() {
    clear
    echo -e "${RED}"
    echo "  ██████╗██╗  ██╗██╗  ██╗██████╗  █████╗ ███╗   ███╗"
    echo "  ██╔════╝██║  ██║╚██╗██╔╝██╔══██╗██╔══██╗████╗ ████║"
    echo "  ██║     ███████║ ╚███╔╝ ██████╔╝███████║██╔████╔██║"
    echo "  ██║     ██╔══██║ ╚██╔╝  ██╔═══╝ ██╔══██║██║╚██╔╝██║"
    echo "  ╚██████╗██║  ██║  ██║   ██║     ██║  ██║██║ ╚═╝ ██║"
    echo "   ╚═════╝╚═╝  ╚═╝  ╚═╝   ╚═╝     ╚═╝  ╚═╝╚═╝     ╚═╝"
    echo -e "${NC}"
    echo -e "       ${BOLD}󰄀  WEBCAM PRIVACY, RECORD & CONFIG  󰄀${NC}"
    echo -e "${WHITE}  ─────────────────────────────────────────────────────────${NC}"
    echo ""
}

_check_driver() {
    lsmod | grep -q "^uvcvideo"
}

_check_processes() {
    local dev
    for dev in /dev/video*; do
        if [ -c "$dev" ] && lsof "$dev" &>/dev/null; then
            return 0
        fi
    done
    return 1
}

_get_camera_users() {
    local dev users=""
    for dev in /dev/video*; do
        if [ -c "$dev" ]; then
            local out
            out=$(lsof -t "$dev" 2>/dev/null)
            if [ -n "$out" ]; then
                while read -r pid; do
                    if [ -n "$pid" ]; then
                        local name
                        name=$(ps -p "$pid" -o comm= 2>/dev/null)
                        users+="Proceso: ${BOLD}$name${NC} (PID: $pid) en $dev\n"
                    fi
                done <<< "$out"
            fi
        fi
    done
    echo -e "$users"
}

# --- 1. Diagnóstico ---
check_status() {
    show_banner
    echo -e "  ${BOLD}Estado del Módulo de la Cámara (Kernel):${NC}"
    if _check_driver; then
        echo -e "  󰄀  Driver:   ${GREEN}HABILITADO${NC} (Módulo 'uvcvideo' cargado)"
    else
        echo -e "  󰄀  Driver:   ${RED}DESHABILITADO${NC} (Cámara bloqueada físicamente por software)"
    fi
    
    echo ""
    echo -e "  ${BOLD}Uso de la Cámara en Tiempo Real:${NC}"
    if _check_processes; then
        echo -e "    Estado:   ${RED}¡ACTIVO Y CAPTURANDO!${NC}"
        echo ""
        echo -e "  ${YELLOW}Aplicaciones accediendo a la cámara:${NC}"
        _get_camera_users | sed 's/^/  /'
    else
        echo -e "  󰄬  Estado:   ${WHITE}Inactivo (Nadie está usando tu cámara)${NC}"
    fi
    echo -e "${WHITE}  ─────────────────────────────────────────────────────────${NC}"
    echo ""
    read -n 1 -s -r -p "  Presiona cualquier tecla para continuar..."
}

# --- 2. Bloquear/Activar ---
toggle_camera() {
    show_banner
    if _check_driver; then
        echo -e "  ${YELLOW}  Bloqueando el driver de la cámara web (Desinstalando uvcvideo)...${NC}"
        echo -e "  Se requieren permisos de administrador."
        echo ""
        if sudo modprobe -r uvcvideo; then
            notify-send -t 3000 -i camera-disabled "Cámara Web" "Cámara bloqueada de forma segura (Modo Privado)"
            echo -e "  ${GREEN}󰄬  Cámara deshabilitada correctamente. El hardware está inaccesible.${NC}"
        else
            notify-send -u critical -i dialog-error "Cámara Web" "Error al bloquear la cámara web."
            echo -e "  ${RED}󰅖  Error al descargar el módulo 'uvcvideo'.${NC}"
        fi
    else
        echo -e "  ${CYAN}  Activando el driver de la cámara web (Cargando uvcvideo)...${NC}"
        echo -e "  Se requieren permisos de administrador."
        echo ""
        if sudo modprobe uvcvideo; then
            notify-send -t 3000 -i camera-web "Cámara Web" "Cámara habilitada y lista para su uso"
            echo -e "  ${GREEN}󰄬  Cámara habilitada correctamente.${NC}"
        else
            notify-send -u critical -i dialog-error "Cámara Web" "Error al activar la cámara web."
            echo -e "  ${RED}󰅖  Error al cargar el módulo 'uvcvideo'.${NC}"
        fi
    fi
    echo ""
    sleep 1.5
}

# --- 3. Vista Previa ---
preview_camera() {
    show_banner
    if ! _check_driver; then
        echo -e "  ${RED}[ERROR]${NC} La cámara está deshabilitada en el kernel."
        echo -e "  Activa primero la cámara para poder probarla."
        echo ""
        read -n 1 -s -r -p "  Presiona cualquier tecla para continuar..."
        return
    fi

    local dev=""
    for d in /dev/video*; do
        if [ -c "$d" ]; then
            dev="$d"
            break
        fi
    done

    if [ -z "$dev" ]; then
        echo -e "  ${RED}[ERROR]${NC} No se encontró ningún dispositivo de vídeo (/dev/video*)."
        echo ""
        read -n 1 -s -r -p "  Presiona cualquier tecla para continuar..."
        return
    fi

    if ! command -v ffplay &>/dev/null; then
        echo -e "  ${RED}[ERROR]${NC} Se requiere 'ffplay' para la vista previa de la cámara."
        echo -e "  Por favor, instala: pacman -S ffmpeg (incluye ffplay)"
        echo ""
        read -n 1 -s -r -p "  Presiona cualquier tecla para continuar..."
        return
    fi

    echo -e "  ${GREEN}Lanzando vista previa interactiva de la cámara: $dev...${NC}"
    echo -e "  Configuración activa: ${CYAN}${CAM_RES} @ ${CAM_FPS} FPS${NC}"
    echo -e "  Cierra la ventana de vídeo para finalizar la vista previa."
    echo ""
    
    # Lanzar ffplay con los parámetros configurados de forma no bloqueante con baja latencia y filtro espejo si está activo
    local ffplay_args=(-f v4l2 -input_format mjpeg -video_size "$CAM_RES" -framerate "$CAM_FPS" -fflags nobuffer -flags low_delay -framedrop)
    if [ "$MIRROR_MODE" = "Sí" ]; then
        ffplay_args+=(-vf hflip)
    fi
    ffplay "${ffplay_args[@]}" "$dev" -window_title "Spidey Cam Preview" &>/dev/null &
    
    sleep 1.5
}

# --- 4. Grabar Vídeo ---
record_camera() {
    show_banner
    if ! _check_driver; then
        echo -e "  ${RED}[ERROR]${NC} La cámara está deshabilitada en el kernel."
        echo ""
        read -n 1 -s -r -p "  Presiona cualquier tecla para continuar..."
        return
    fi

    local dev=""
    for d in /dev/video*; do
        if [ -c "$d" ]; then
            dev="$d"
            break
        fi
    done

    if [ -z "$dev" ]; then
        echo -e "  ${RED}[ERROR]${NC} No se encontró ningún dispositivo de vídeo (/dev/video*)."
        echo ""
        read -n 1 -s -r -p "  Presiona cualquier tecla para continuar..."
        return
    fi

    if ! command -v ffmpeg &>/dev/null || ! command -v ffplay &>/dev/null; then
        echo -e "  ${RED}[ERROR]${NC} Se requieren 'ffmpeg' y 'ffplay' para realizar grabaciones con preview."
        echo -e "  Instala: pacman -S ffmpeg"
        echo ""
        read -n 1 -s -r -p "  Presiona cualquier tecla para continuar..."
        return
    fi

    mkdir -p "$OUTPUT_DIR"
    local filename="$OUTPUT_DIR/Webcam_$(date +%Y-%m-%d_%H-%M-%S).mp4"

    echo -e "  ${RED}󰑋  PREPARANDO GRABACIÓN DE CÁMARA WEB  󰑋${NC}"
    echo -e "  ─────────────────────────────────────────────────────────"
    echo -e "  Dispositivo: ${CYAN}$dev${NC}"
    echo -e "  Resolución:  ${CYAN}$CAM_RES${NC}"
    echo -e "  FPS:         ${CYAN}$CAM_FPS${NC}"
    echo -e "  Audio:       ${CYAN}$RECORD_AUDIO${NC} (Micrófono por defecto)"
    echo -e "  Destino:     ${WHITE}$filename${NC}"
    echo -e "  ─────────────────────────────────────────────────────────"
    echo ""
    read -r -p "  ¿Deseas iniciar la grabación ahora? [S/n]: " confirm
    if [[ "$confirm" =~ ^[nN]$ ]]; then
        return
    fi

    show_banner
    echo -e "  ${RED}󰑋  GRABANDO... Cierra la ventana de vista previa para finalizar y guardar la grabación.${NC}"
    echo ""

    notify-send -t 2000 -i camera-web "Grabadora Webcam" "Iniciando grabación y vista previa..."

    # Crear tubería nombrada (FIFO) temporal para la vista previa
    local fifo="/tmp/syscam_preview_$(date +%s).fifo"
    rm -f "$fifo"
    mkfifo "$fifo"

    # Construir el filter_complex según el modo espejo
    local filter_complex="[0:v]split=2[out1][out2]"
    if [ "$MIRROR_MODE" = "Sí" ]; then
        filter_complex="[0:v]hflip,split=2[out1][out2]"
    fi

    # Grabar con audio y/o sólo vídeo dividiendo los frames a la FIFO
    if [ "$RECORD_AUDIO" = "Sí" ]; then
        (trap '' PIPE; exec ffmpeg -y \
            -f v4l2 -input_format mjpeg -video_size "$CAM_RES" -framerate "$CAM_FPS" -i "$dev" \
            -f pulse -i default \
            -filter_complex "$filter_complex" \
            -map "[out1]" -map 1:a -c:v libx264 -preset ultrafast -crf 23 -pix_fmt yuv420p -c:a aac -b:a 128k "$filename" \
            -map "[out2]" -c:v mjpeg -f mjpeg -flush_packets 1 "$fifo" &>/dev/null) &
    else
        (trap '' PIPE; exec ffmpeg -y \
            -f v4l2 -input_format mjpeg -video_size "$CAM_RES" -framerate "$CAM_FPS" -i "$dev" \
            -filter_complex "$filter_complex" \
            -map "[out1]" -c:v libx264 -preset ultrafast -crf 23 -pix_fmt yuv420p "$filename" \
            -map "[out2]" -c:v mjpeg -f mjpeg -flush_packets 1 "$fifo" &>/dev/null) &
    fi
    local ffmpeg_pid=$!

    # Lanzar ffplay leyendo de la FIFO (se ejecuta en primer plano con latencia cero)
    ffplay -f mjpeg -probesize 32 -analyzeduration 0 -sync ext -fflags nobuffer -flags low_delay -framedrop -window_title "Grabando... Cierra esta ventana para guardar" "$fifo" &>/dev/null

    # En cuanto ffplay se cierra:
    # 1. Iniciamos un cat en background para vaciar la FIFO y evitar que ffmpeg se bloquee o reciba SIGPIPE
    cat "$fifo" >/dev/null &
    local cat_pid=$!

    # 2. Enviamos SIGINT (Ctrl+C) a ffmpeg para que finalice correctamente el archivo de vídeo
    kill -INT "$ffmpeg_pid" 2>/dev/null
    wait "$ffmpeg_pid" 2>/dev/null || true

    # 3. Limpiamos el proceso cat y la FIFO
    kill "$cat_pid" 2>/dev/null
    rm -f "$fifo"

    # Confirmación de finalización
    if [ -f "$filename" ]; then
        local size
        size=$(du -sh "$filename" 2>/dev/null | cut -f1)
        show_banner
        echo -e "  ${GREEN}󰄬  ¡Grabación completada con éxito!${NC}"
        echo -e "  Archivo guardado: ${WHITE}$(basename "$filename")${NC} ($size)"
        echo ""
        notify-send -t 3500 -i emblem-videos "Grabación Guardada" "$(basename "$filename")\nTamaño: $size"
    else
        echo -e "  ${RED}󰅖  Hubo un problema al generar la grabación.${NC}"
        echo ""
    fi

    read -n 1 -s -r -p "  Presiona cualquier tecla para continuar..."
}

# --- 5. Configurar Calidad ---
configure_settings() {
    while true; do
        show_banner
        echo -e "  ${BOLD}Ajustes de Calidad y Grabación:${NC}"
        echo -e "  Configure los parámetros de captura de tu cámara web:"
        echo ""
        
        local menu_config="1. 󰗚  Resolución: $CAM_RES\n2. 󰓅  Framerate: $CAM_FPS FPS\n3. 󰕾  Grabar Audio: $RECORD_AUDIO\n4. 󰅏  Modo Espejo: $MIRROR_MODE\n5. 󰌑  Guardar y Volver Atrás"
        local sel
        sel=$(echo -e "$menu_config" | fzf \
            --prompt=" 󰒓  Configuración ❯ " \
            --header="Selecciona un ajuste para modificarlo:")

        case "$sel" in
            *Resolución*)
                local res_opts="1920x1080 (Full HD)\n1280x720 (HD Ready)\n800x600 (SVGA)\n640x480 (VGA)\n320x240 (QVGA)"
                local new_res
                new_res=$(echo -e "$res_opts" | fzf --prompt=" Resoluciones Soportadas ❯ " | awk '{print $1}')
                if [ -n "$new_res" ]; then
                    CAM_RES="$new_res"
                fi
                ;;
            *Framerate*)
                local fps_opts="60 FPS\n30 FPS\n24 FPS\n15 FPS"
                local new_fps
                new_fps=$(echo -e "$fps_opts" | fzf --prompt=" Framerates Soportados ❯ " | awk '{print $1}')
                if [ -n "$new_fps" ]; then
                    CAM_FPS="$new_fps"
                fi
                ;;
            *Audio*)
                if [ "$RECORD_AUDIO" = "Sí" ]; then
                    RECORD_AUDIO="No"
                else
                    RECORD_AUDIO="Sí"
                fi
                ;;
            *Espejo*)
                if [ "$MIRROR_MODE" = "Sí" ]; then
                    MIRROR_MODE="No"
                else
                    MIRROR_MODE="Sí"
                fi
                ;;
            *Guardar*|*)
                # Guardar en archivo de configuración
                mkdir -p "$(dirname "$CONFIG_FILE")"
                cat > "$CONFIG_FILE" << EOF
# Configuración generada automáticamente por sys-cam
CAM_RES="$CAM_RES"
CAM_FPS="$CAM_FPS"
RECORD_AUDIO="$RECORD_AUDIO"
MIRROR_MODE="$MIRROR_MODE"
EOF
                notify-send -t 2000 -i preferences-system "Configuración" "Ajustes de cámara guardados con éxito"
                break
                ;;
        esac
    done
}

# --- 6. Interrumpir Espías ---
kill_camera_users() {
    show_banner
    if ! _check_processes; then
        echo -e "  ${GREEN}󰄬  No hay ningún proceso sospechoso usando tu cámara web.${NC}"
        echo ""
        read -n 1 -s -r -p "  Presiona cualquier tecla para continuar..."
        return
    fi

    echo -e "  ${RED}  Peligro: Las siguientes aplicaciones están transmitiendo desde tu cámara:${NC}"
    echo ""
    _get_camera_users | sed 's/^/  /'
    echo ""
    read -r -p "  ¿Deseas forzar el cierre de TODOS estos procesos? [s/N]: " confirm
    if [[ "$confirm" =~ ^[sS]$ ]]; then
        local dev
        for dev in /dev/video*; do
            if [ -c "$dev" ]; then
                local pids
                pids=$(lsof -t "$dev" 2>/dev/null)
                if [ -n "$pids" ]; then
                    while read -r pid; do
                        if [ -n "$pid" ]; then
                            echo -e "  ${YELLOW}Matando proceso PID: $pid...${NC}"
                            kill -9 "$pid" 2>/dev/null
                        fi
                    done <<< "$pids"
                fi
            fi
        done
        echo ""
        echo -e "  ${GREEN}󰄬  Todos los procesos sospechosos han sido interrumpidos.${NC}"
        notify-send -t 3000 -i security-high "Seguridad de Cámara" "Procesos sospechosos interrumpidos con éxito"
    else
        echo -e "  Operación cancelada."
    fi
    echo ""
    sleep 1.5
}

main_loop() {
    while true; do
        show_banner
        
        # Estado rápido para el menú
        local drv_status="[DESACTIVADA]"
        _check_driver && drv_status="[ACTIVA]"
        
        local use_status="[Inactivo]"
        _check_processes && use_status="[¡EN USO ACTIVO!]"

        local mirror_status="Normal"
        [ "$MIRROR_MODE" = "Sí" ] && mirror_status="Espejo"
        local menu="1.   Diagnóstico Completo de Cámara $use_status\n2. 󰄀  Alternar Habilitar/Bloquear Cámara $drv_status\n3.   Vista Previa Interactiva (MPV Test)\n4. 󰑋  Grabar Vídeo desde Cámara (ffmpeg)\n5. 󰒓  Ajustar Calidad y Configuración ($CAM_RES @ $CAM_FPS FPS, $mirror_status)\n6. 󰅖  Interrumpir Aplicaciones Espías (Kill Camera Users)\n7. 󰌑  Salir"
        
        local choice
        choice=$(echo -e "$menu" | fzf \
            --prompt=" 󰄀  Spidey Cam Control ❯ " \
            --header="Protector de Privacidad, Grabación y Ajustes:")
            
        case "$choice" in
            *Diagnóstico*)
                check_status
                ;;
            *Alternar*)
                toggle_camera
                ;;
            *Vista*)
                preview_camera
                ;;
            *Grabar*)
                record_camera
                ;;
            *Ajustar*)
                configure_settings
                ;;
            *Interrumpir*)
                kill_camera_users
                ;;
            *Salir*|*)
                clear
                exit 0
                ;;
        esac
    done
}

main_loop
