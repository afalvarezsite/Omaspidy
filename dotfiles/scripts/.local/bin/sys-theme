#!/usr/bin/env bash
# ==============================================================================
# SYS-THEME: Selector Dinámico de Skins del Ecosistema Spider-Man
# Estética: Ecosistema Spider-Man
# ==============================================================================

# Colores visuales Spider-Man para la interfaz del selector
RED='\033[1;31m'
GREEN='\033[1;32m'
BLUE='\033[1;34m'
YELLOW='\033[1;33m'
WHITE='\033[1;37m'
NC='\033[0m'
BOLD='\033[1m'

msg() { echo -e "${BLUE}::${NC} $1"; }
msg_ok() { echo -e "${GREEN}==>${NC} $1"; }
msg_err() { echo -e "${RED}[ERROR]${NC} $1"; }

show_banner() {
    clear
    echo -e "${RED}"
    echo "  ███████╗██╗  ██╗██╗███╗   ██╗███████╗"
    echo "  ██╔════╝██║  ██║██║████╗  ██║██╔════╝"
    echo "  ███████╗███████║██║██╔██╗ ██║███████╗"
    echo "  ╚════██║██╔══██║██║██║╚██╗██║╚════██║"
    echo "  ███████║██║  ██║██║██║ ╚████║███████║"
    echo "  ╚══════╝╚═╝  ╚═╝╚═╝╚═╝  ╚═══╝╚══════╝"
    echo -e "${NC}"
    echo -e "       ${BOLD}󰉼  SKIN SELECTOR MANAGER  󰉼${NC}"
    echo -e "${WHITE}  ─────────────────────────────────────────────────────────${NC}"
    echo ""
}

THEME_DIR="$HOME/.config/theme"
SKINS_DIR="$THEME_DIR/skins"

# Comprobar directorios
if [ ! -d "$THEME_DIR" ] || [ ! -d "$SKINS_DIR" ]; then
    # Soporte para ejecución en el repositorio local antes de que stow actúe
    # Intentar buscar en el repositorio local
    WORKSPACE_SKINS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../theme/.config/theme/skins" 2>/dev/null && pwd)"
    if [ -d "$WORKSPACE_SKINS_DIR" ]; then
        THEME_DIR="$(cd "$WORKSPACE_SKINS_DIR/.." && pwd)"
        SKINS_DIR="$THEME_DIR/skins"
    else
        msg_err "Directorio de skins no encontrado. Asegúrate de stowear el módulo 'theme'."
        exit 1
    fi
fi

# Listado de skins preconfiguradas
OPTIONS="1.   Spider-Man Classic (Rojo/Negro/Azul Neón)\n2.   Symbiote Suit (Negro profundo/Blanco/Gris)\n3. ⚡  Miles Morales (Negro mate/Rojo/Púrpura)"

show_banner

# Selección interactiva con FZF heredando opciones estéticas por defecto
SKIN_SELECT=$(echo -e "$OPTIONS" | fzf \
    --prompt=" Selecciona una Skin ❯ " \
    --header="Elige el aspecto visual de tu ecosistema:" \
    --layout=reverse \
    --border=rounded --padding=1,2 --margin=2% --pointer="" --marker="󰄬")

if [ -z "$SKIN_SELECT" ]; then
    msg "Operación cancelada. Manteniendo el tema actual."
    exit 0
fi

# Identificar la skin elegida
case "$SKIN_SELECT" in
    *Classic*)
        SKIN="classic_spidey"
        ;;
    *Symbiote*)
        SKIN="symbiote"
        ;;
    *Miles*)
        SKIN="miles_morales"
        ;;
    *)
        msg_err "Skin no reconocida."
        exit 1
        ;;
esac

msg "Aplicando skin: ${SKIN_SELECT#*. }..."

# Cargar las variables de color del tema seleccionado inmediatamente
source "$SKINS_DIR/${SKIN}.sh"

# 1. Enlazar archivos dinámicos del tema activo en ~/.config/theme/
ln -sf "$SKINS_DIR/${SKIN}.sh" "$THEME_DIR/active.sh"
ln -sf "$SKINS_DIR/${SKIN}.conf" "$THEME_DIR/active.conf"
ln -sf "$SKINS_DIR/${SKIN}.css" "$THEME_DIR/active.css"

# 2. Actualizar el symlink de Starship config
ln -sf "$SKINS_DIR/${SKIN}_starship.toml" "$HOME/.config/starship.toml"

# 3. Actualizar el symlink de Mako config
mkdir -p "$HOME/.config/mako"
ln -sf "$SKINS_DIR/${SKIN}_mako.conf" "$HOME/.config/mako/config"

# 4. Actualizar el symlink de Alacritty config
mkdir -p "$HOME/.config/alacritty"
ln -sf "$SKINS_DIR/${SKIN}_alacritty.toml" "$HOME/.config/alacritty/active.toml"

# 5. Generar configuración de colores dinámica para Yazi
if [ -d "$HOME/.config/yazi" ]; then
    msg "Actualizando tema dinámico de Yazi..."
    cat << YAZI_THEME_EOF > "$HOME/.config/yazi/theme.toml"
# theme.toml
# Paleta de colores dinámica para Yazi
# Generado automáticamente por sys-theme — NO EDITAR

[manager]
cwd = { fg = "${COLOR_PRIMARY}", bold = true }
hovered = { fg = "${COLOR_BG_DARK}", bg = "${COLOR_PRIMARY}", bold = true }
preview_hovered = { bg = "${COLOR_BG_LIGHT}" }

find_keyword = { fg = "${COLOR_PRIMARY_GLOW}", bold = true, italic = true }
find_position = { fg = "${COLOR_PRIMARY_GLOW}", bg = "reset", italic = true }

marker_copied = { fg = "#00e676", bg = "#00e676" }
marker_cut = { fg = "${COLOR_PRIMARY_GLOW}", bg = "${COLOR_PRIMARY_GLOW}" }
marker_selected = { fg = "${COLOR_PRIMARY_GLOW}", bg = "${COLOR_PRIMARY_GLOW}" }

border_symbol = "│"
border_style = { fg = "${COLOR_PRIMARY}" }

[status]
separator_open = ""
separator_close = ""

# Modo normal
mode_normal = { bg = "${COLOR_PRIMARY}", fg = "${COLOR_BG_DARK}", bold = true }
# Modo seleccion
mode_select = { bg = "${COLOR_PRIMARY_GLOW}", fg = "${COLOR_BG_DARK}", bold = true }
# Modo no establecido
mode_unset = { bg = "${COLOR_PRIMARY_GLOW}", fg = "${COLOR_BG_DARK}", bold = true }

progress_label = { fg = "${COLOR_FG}", bold = true }
progress_normal = { fg = "${COLOR_PRIMARY}", bg = "${COLOR_BG_LIGHT}" }
progress_error = { fg = "${COLOR_PRIMARY_GLOW}", bg = "${COLOR_BG_LIGHT}" }

[select]
border = { fg = "${COLOR_PRIMARY}" }
active = { fg = "${COLOR_BG_DARK}", bg = "${COLOR_PRIMARY}", bold = true }
inactive = { fg = "${COLOR_FG}" }

[input]
border = { fg = "${COLOR_PRIMARY}" }
title = { fg = "${COLOR_PRIMARY}", bold = true }
value = { fg = "${COLOR_FG}" }
selected = { bg = "${COLOR_PRIMARY}" }

[completion]
border = { fg = "${COLOR_PRIMARY}" }
active = { bg = "${COLOR_PRIMARY}", fg = "${COLOR_BG_DARK}" }
inactive = { fg = "${COLOR_FG}" }

[help]
on = { fg = "${COLOR_PRIMARY}", bold = true }
exec = { fg = "${COLOR_PRIMARY_GLOW}" }
desc = { fg = "${COLOR_FG}" }
hovered = { bg = "${COLOR_BG_LIGHT}", bold = true }
footer = { fg = "${COLOR_INACTIVE}" }

[filetype]
rules = [
    # Imágenes
    { mime = "image/*", fg = "${COLOR_SECONDARY}" },
    # Videos
    { mime = "video/*", fg = "${COLOR_PRIMARY_GLOW}" },
    # Audio
    { mime = "audio/*", fg = "${COLOR_PRIMARY}" },
    # Archivos comprimidos
    { mime = "application/zip", fg = "#ffd600" },
    { mime = "application/gzip", fg = "#ffd600" },
    { mime = "application/x-tar", fg = "#ffd600" },
    { mime = "application/x-bzip*", fg = "#ffd600" },
    { mime = "application/x-7z-compressed", fg = "#ffd600" },
    { mime = "application/x-rar", fg = "#ffd600" },
    # Documentos
    { mime = "application/pdf", fg = "${COLOR_PRIMARY_GLOW}" },
    # Scripts y código
    { url = "*.sh", fg = "#00e676", bold = true },
    { url = "*.py", fg = "${COLOR_SECONDARY}", bold = true },
    { url = "*.rs", fg = "${COLOR_PRIMARY_GLOW}", bold = true },
    { url = "*.c", fg = "#54a0ff", bold = true },
    { url = "*.cpp", fg = "#54a0ff", bold = true },
    # Por defecto
    { url = "*", fg = "${COLOR_FG}" }
]
YAZI_THEME_EOF
fi

# 6. Generar configuración de colores dinámica para Qt (Qt5ct y Qt6ct)
msg "Actualizando tema dinámico de Qt (Qt5ct y Qt6ct)..."
mkdir -p "$HOME/.config/qt5ct/colors"
mkdir -p "$HOME/.config/qt6ct/colors"

cat << QT_THEME_EOF > "$HOME/.config/qt5ct/colors/active.conf"
[ColorScheme]
active_colors=${COLOR_FG}, ${COLOR_BG_LIGHT}, ${COLOR_BG_LIGHT}, ${COLOR_BG_LIGHT}, ${COLOR_BG_DARK}, ${COLOR_BG_DARK}, ${COLOR_FG}, #ffffff, ${COLOR_FG}, ${COLOR_BG_DARK}, ${COLOR_BG_LIGHT}, #000000, ${COLOR_PRIMARY}, #ffffff, ${COLOR_SECONDARY}, ${COLOR_PRIMARY_GLOW}, ${COLOR_BG_DARK}, #000000, ${COLOR_BG_DARK}, ${COLOR_FG}
disabled_colors=${COLOR_INACTIVE}, ${COLOR_BG_LIGHT}, ${COLOR_BG_LIGHT}, ${COLOR_BG_LIGHT}, ${COLOR_BG_DARK}, ${COLOR_BG_DARK}, ${COLOR_INACTIVE}, ${COLOR_INACTIVE}, ${COLOR_INACTIVE}, ${COLOR_BG_DARK}, ${COLOR_BG_LIGHT}, #000000, ${COLOR_BG_LIGHT}, ${COLOR_INACTIVE}, ${COLOR_INACTIVE}, ${COLOR_INACTIVE}, ${COLOR_BG_DARK}, #000000, ${COLOR_BG_DARK}, ${COLOR_INACTIVE}
inactive_colors=${COLOR_FG}, ${COLOR_BG_LIGHT}, ${COLOR_BG_LIGHT}, ${COLOR_BG_LIGHT}, ${COLOR_BG_DARK}, ${COLOR_BG_DARK}, ${COLOR_FG}, #ffffff, ${COLOR_FG}, ${COLOR_BG_DARK}, ${COLOR_BG_LIGHT}, #000000, ${COLOR_PRIMARY}, #ffffff, ${COLOR_SECONDARY}, ${COLOR_PRIMARY_GLOW}, ${COLOR_BG_DARK}, #000000, ${COLOR_BG_DARK}, ${COLOR_FG}
QT_THEME_EOF

cp "$HOME/.config/qt5ct/colors/active.conf" "$HOME/.config/qt6ct/colors/active.conf"

# --- Recargas al Vuelo ---

# Recargar Hyprland
if pgrep -x Hyprland &>/dev/null; then
    msg "Recargando configuraciones de Hyprland..."
    hyprctl reload &>/dev/null
fi

# Recargar Waybar en caliente (envía señal USR2 para recargar CSS y Config)
if pgrep -x waybar &>/dev/null; then
    msg "Recargando Waybar..."
    pkill -USR2 waybar
fi

# Recargar Mako
if pgrep -x mako &>/dev/null; then
    msg "Recargando demonio de notificaciones Mako..."
    makoctl reload &>/dev/null
fi

# --- Señal de recarga de tema para sesiones Zsh ya abiertas ---
# env.zsh monitoriza el mtime de este archivo con un hook precmd
_SIGNAL_DIR="$HOME/.cache/zsh"
mkdir -p "$_SIGNAL_DIR"

# Recargar el skin para extraer el nuevo FZF_THEME
# shellcheck source=/dev/null
source "$SKINS_DIR/${SKIN}.sh"

# Escribir las nuevas variables FZF al archivo de señal
cat > "$_SIGNAL_DIR/theme_signal.zsh" << SIGNAL_EOF
# Generado automáticamente por sys-theme — NO EDITAR
export FZF_DEFAULT_OPTS="--layout=reverse --border=rounded --padding=1,2 --margin=2% --prompt=' ❯ ' --pointer='' --marker='󰄬' $FZF_THEME"
SIGNAL_EOF

msg_ok "Skin ${SKIN_SELECT#*. } aplicada con éxito en todo tu ecosistema."
msg "  Los colores de FZF se actualizarán en las terminales abiertas en el próximo prompt."

