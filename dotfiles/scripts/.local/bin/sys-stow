#!/usr/bin/env bash
# ==============================================================================
# SYS-STOW: Validador y Gestor Interactivo de Módulos Dotfiles (Stow)
# Estética: Ecosistema Spider-Man (Rojo Neón y Negro)
# ==============================================================================

# Cargar variables de colores del tema activo
source "$HOME/.config/theme/active.sh" 2>/dev/null
export FZF_DEFAULT_OPTS="
    --layout=reverse
    ${FZF_THEME:---color=\"bg+:#16171f,bg:#0c0d12,spinner:#ff3b5c,hl:#00e5ff\" --color=\"fg:#f8f9fa,header:#ff3b5c,info:#d500f9,pointer:#00e676\" --color=\"marker:#e60026,fg+:#ffffff,prompt:#e60026,hl+:#00e5ff,border:#ff1e43\"}
    --border=rounded --padding=1,2 --margin=2%
    --prompt='  ❯ ' --pointer='' --marker='󰄬'
"

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
WHITE='\033[1;37m'
CYAN='\033[1;36m'
NC='\033[0m'
BOLD='\033[1m'

show_banner() {
    clear
    echo -e "${RED}"
    echo "  ███████╗████████╗ ██████╗ ██╗    ██╗"
    echo "  ██╔════╝╚══██╔══╝██╔═══██╗██║    ██║"
    echo "  ███████╗   ██║   ██║   ██║██║ █╗ ██║"
    echo "  ╚════██║   ██║   ██║   ██║██║███╗██║"
    echo "  ███████║   ██║   ╚██████╔╝╚███╔███╔╝"
    echo "  ╚══════╝   ╚═╝    ╚═════╝  ╚══╝╚══╝ "
    echo -e "${NC}"
    echo -e "       ${BOLD}󰏗  DOTFILES STOW MANAGER  󰏗${NC}"
    echo -e "${WHITE}  ─────────────────────────────────────────────────────────${NC}"
    echo ""
}

# Encontrar ruta del repositorio
DOTFILES_DIR="$HOME/.dotfiles"
CURRENT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"

# Buscar recursivamente
if [[ -d "$CURRENT_DIR/../../../dotfiles" ]]; then
    DOTFILES_DIR="$(cd "$CURRENT_DIR/../../.." && pwd)"
elif [[ -d "$HOME/Documentos/ArchInstallGuide" ]]; then
    DOTFILES_DIR="$HOME/Documentos/ArchInstallGuide"
fi

show_banner

if [[ ! -d "$DOTFILES_DIR/dotfiles" ]]; then
    echo -e "  ${RED}[ERROR]${NC} No se encontró la carpeta dotfiles en: $DOTFILES_DIR"
    read -n 1 -s -r -p "  Presiona cualquier tecla para salir..."
    exit 1
fi

MODULES=(alacritty anyrun hypr mako nvim scripts starship waybar zsh git antigravity lazygit bat fastfetch gtk theme swayosd mpv)

check_status() {
    show_banner
    echo -e "  ${CYAN}Analizando estado de los módulos de Stow...${NC}"
    echo ""
    
    cd "$DOTFILES_DIR/dotfiles" || exit 1
    
    for mod in "${MODULES[@]}"; do
        if [ -d "$mod" ]; then
            # Buscar un archivo clave en el home para ver si está enlazado
            is_linked=false
            case "$mod" in
                alacritty) [ -L "$HOME/.config/alacritty" ] && is_linked=true ;;
                anyrun) [ -L "$HOME/.config/anyrun" ] && is_linked=true ;;
                hypr) [ -L "$HOME/.config/hypr" ] && is_linked=true ;;
                mako) [ -L "$HOME/.config/mako" ] && is_linked=true ;;
                nvim) [ -L "$HOME/.config/nvim" ] && is_linked=true ;;
                scripts) [ -L "$HOME/.local/bin/hypr-keys" ] && is_linked=true ;;
                starship) [ -L "$HOME/.config/starship.toml" ] && is_linked=true ;;
                waybar) [ -L "$HOME/.config/waybar" ] && is_linked=true ;;
                zsh) [ -L "$HOME/.zshrc" ] && is_linked=true ;;
                git) [ -L "$HOME/.gitconfig" ] && is_linked=true ;;
                antigravity) [ -L "$HOME/.config/antigravity" ] && is_linked=true ;;
                lazygit) [ -L "$HOME/.config/lazygit" ] && is_linked=true ;;
                bat) [ -L "$HOME/.config/bat" ] && is_linked=true ;;
                fastfetch) [ -L "$HOME/.config/fastfetch" ] && is_linked=true ;;
                gtk) [ -L "$HOME/.config/gtk-3.0" ] && is_linked=true ;;
                theme) [ -L "$HOME/.config/theme" ] && is_linked=true ;;
                swayosd) [ -L "$HOME/.config/swayosd" ] && is_linked=true ;;
                mpv) [ -L "$HOME/.config/mpv" ] && is_linked=true ;;
            esac
            
            if $is_linked; then
                echo -e "  ${GREEN}●${NC}  %-15s ${GREEN}[ENLAZADO]${NC}" "$mod"
            else
                echo -e "  ${RED}●${NC}  %-15s ${RED}[DESVINCULADO o CONFLICTO]${NC}" "$mod"
            fi
        fi
    done
    echo ""
    read -n 1 -s -r -p "  Presiona cualquier tecla para continuar..."
}

restow_all() {
    show_banner
    echo -e "  ${YELLOW}⚠ Preparando re-despliegue completo de todos los módulos...${NC}"
    echo ""
    
    cd "$DOTFILES_DIR/dotfiles" || exit 1
    
    # Hacer stow con re-stow (-R)
    echo -e "  ${CYAN}Ejecutando: stow -R ${MODULES[*]}${NC}"
    if stow -R "${MODULES[@]}"; then
        echo ""
        echo -e "  ${GREEN}✓ Todos los enlaces simbólicos de dotfiles han sido recreados con éxito.${NC}"
    else
        echo ""
        echo -e "  ${RED}❌ Hubo problemas al aplicar Stow. Revisa conflictos de archivos locales.${NC}"
    fi
    echo ""
    read -n 1 -s -r -p "  Presiona cualquier tecla para continuar..."
}

restow_specific() {
    show_banner
    cd "$DOTFILES_DIR/dotfiles" || exit 1
    
    # Seleccionar módulo interactivo
    local opts=""
    for mod in "${MODULES[@]}"; do
        opts+="$mod\n"
    done
    
    local sel
    sel=$(echo -e "$opts" | grep -v '^$' | fzf \
        --prompt=" 󰏗  Selecciona módulo a re-stowear ❯ " \
        --header="Selecciona una configuración específica:")
        
    if [ -n "$sel" ]; then
        show_banner
        echo -e "  ${CYAN}Re-stoweando módulo: $sel...${NC}"
        if stow -R "$sel"; then
            echo ""
            echo -e "  ${GREEN}✓ Módulo '$sel' re-stoweado correctamente.${NC}"
        else
            echo ""
            echo -e "  ${RED}❌ Error al stowear '$sel'. Asegúrate de que no existan carpetas locales con el mismo nombre.${NC}"
        fi
        echo ""
        read -n 1 -s -r -p "  Presiona cualquier tecla para continuar..."
    fi
}

main_loop() {
    while true; do
        show_banner
        local menu="1.   Comprobar Estado de los Enlaces\n2. 󰚚  Re-desplegar Todos los Dotfiles (stow -R)\n3. 󰏗  Re-stowear Módulo Específico\n4. 󰌑  Salir"
        
        local choice
        choice=$(echo -e "$menu" | fzf \
            --prompt="  ❯ " \
            --header="Gestor de despliegue de tu entorno:")
            
        case "$choice" in
            *Estado*)
                check_status
                ;;
            *Todos*)
                restow_all
                ;;
            *Específico*)
                restow_specific
                ;;
            *Salir*|*)
                clear
                exit 0
                ;;
        esac
    done
}

main_loop
