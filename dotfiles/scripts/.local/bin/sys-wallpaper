#!/usr/bin/env bash
# ==============================================================================
# SYS-WALLPAPER: Gestor Dinámico y Permanente de Fondos de Pantalla
# Estética: Ecosistema Spider-Man (Omaspidy)
# ==============================================================================

# Cargar variables de colores del tema activo para consistencia visual
source "$HOME/.config/theme/active.sh" 2>/dev/null
export FZF_DEFAULT_OPTS="
    --layout=reverse
    ${FZF_THEME:---color=\"bg+:#16171f,bg:#0c0d12,spinner:#ff3b5c,hl:#00e5ff\" --color=\"fg:#f8f9fa,header:#ff3b5c,info:#d500f9,pointer:#00e676\" --color=\"marker:#e60026,fg+:#ffffff,prompt:#e60026,hl+:#00e5ff,border:#ff1e43\"}
    --border=rounded --padding=1,2 --margin=2%
    --prompt='  ❯ ' --pointer='' --marker='󰄬'
"

RED='\033[1;31m'
GREEN='\033[1;32m'
BLUE='\033[1;34m'
YELLOW='\033[1;33m'
WHITE='\033[1;37m'
CYAN='\033[1;36m'
NC='\033[0m'
BOLD='\033[1m'

msg() { echo -e "${BLUE}::${NC} $1"; }
msg_ok() { echo -e "${GREEN}==>${NC} $1"; }
msg_err() { echo -e "${RED}[ERROR]${NC} $1"; }

show_banner() {
    clear
    echo -e "${RED}"
    echo "  ██████╗██████╗ ██╗██████╗ ███████╗██╗   ██╗"
    echo "  ██╔════╝██╔══██╗██║██╔══██╗██╔════╝╚██╗ ██╔╝"
    echo "  ███████╗██████╔╝██║██║  ██║█████╗   ╚████╔╝ "
    echo "  ╚════██║██╔═══╝ ██║██║  ██║██╔══╝    ╚██╔╝  "
    echo "  ██████╔╝██║     ██║██████╔╝███████╗   ██║   "
    echo "  ╚═════╝ ╚═╝     ╚═╝╚═════╝ ╚══════╝   ╚═╝   "
    echo -e "${NC}"
    echo -e "       ${BOLD}󰸉  WALLPAPER SYSTEM MANAGER  󰸉${NC}"
    echo -e "${WHITE}  ─────────────────────────────────────────────────────────${NC}"
    echo ""
}

TARGET_WALLPAPER="$HOME/.config/hypr/wallpaper.jpg"

apply_wallpaper() {
    local src_file="$1"
    
    if [ ! -f "$src_file" ]; then
        msg_err "El archivo no existe o no es válido: $src_file"
        exit 1
    fi
    
    # Comprobar si es un archivo de imagen (JPEG/PNG)
    local file_type
    file_type=$(file -b --mime-type "$src_file")
    if [[ ! "$file_type" =~ ^image/ ]]; then
        msg_err "El archivo seleccionado no parece ser una imagen válida (Tipo: $file_type)"
        exit 1
    fi

    show_banner
    msg "Copiando fondo de pantalla a la configuración persistente..."
    
    # Crear el directorio destino si por alguna razón no existe
    mkdir -p "$(dirname "$TARGET_WALLPAPER")"
    
    # Copiar archivo para persistencia permanente si no es ya el mismo archivo
    if [ "$(realpath "$src_file")" != "$(realpath "$TARGET_WALLPAPER" 2>/dev/null)" ]; then
        cp "$src_file" "$TARGET_WALLPAPER"
    fi
    chmod 644 "$TARGET_WALLPAPER"
    
    msg "Actualizando fondo en caliente con Hyprpaper..."
    
    # Si hyprpaper no está corriendo, iniciarlo
    if ! pgrep -x hyprpaper &>/dev/null; then
        hyprpaper &
        sleep 1
    fi
    
    # Recargar el fondo usando IPC en caliente de Hyprpaper v0.8.4
    hyprctl hyprpaper reload "eDP-1,$TARGET_WALLPAPER" &>/dev/null
    hyprctl hyprpaper reload ",$TARGET_WALLPAPER" &>/dev/null
    
    # Enviar notificación del sistema
    notify-send -t 3000 -i image-x-generic "Fondo de Pantalla" "¡Fondo de pantalla actualizado con éxito y guardado permanentemente!"
    
    msg_ok "Fondo de pantalla aplicado correctamente."
    msg "Ruta de origen: $src_file"
    msg "Guardado en: $TARGET_WALLPAPER"
}

# --- Flujo Principal ---

if [ -n "$1" ]; then
    # Modo argumento: se pasó una ruta directa
    apply_wallpaper "$1"
else
    # Modo interactivo: FZF para buscar imágenes en carpetas comunes
    show_banner
    echo -e "  ${CYAN}Buscando imágenes disponibles en tu sistema...${NC}"
    echo ""
    
    # Directorios donde buscar imágenes
    SEARCH_DIRS=("$HOME/Pictures" "$HOME/Imágenes" "$HOME/Downloads" "$HOME/Descargas" "$HOME/Documentos")
    VALID_DIRS=()
    
    for dir in "${SEARCH_DIRS[@]}"; do
        if [ -d "$dir" ]; then
            VALID_DIRS+=("$dir")
        fi
    done
    
    if [ ${#VALID_DIRS[@]} -eq 0 ]; then
        msg_err "No se encontraron directorios de imágenes comunes (Pictures, Downloads, etc.)"
        echo -e "Usa: ${YELLOW}sys-wallpaper /ruta/a/tu/imagen.jpg${NC}"
        exit 1
    fi
    
    # Encontrar imágenes JPEG/PNG de forma recursiva
    IMAGE_SELECT=$(find "${VALID_DIRS[@]}" -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" \) 2>/dev/null | fzf \
        --prompt=" Elige tu nuevo Wallpaper ❯ " \
        --header="Selecciona una imagen para aplicar permanentemente:")
        
    if [ -z "$IMAGE_SELECT" ]; then
        msg "Operación cancelada. Manteniendo fondo de pantalla actual."
        exit 0
    fi
    
    apply_wallpaper "$IMAGE_SELECT"
fi
