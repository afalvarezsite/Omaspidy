#!/usr/bin/env bash
# sys-backup: Wrapper para crear snapshots seguros con Snapper.
# Dependencias: snapper, sudo

if [[ "$EUID" -ne 0 ]]; then
    echo "Este script necesita privilegios de superusuario."
    exec sudo "$0" "$@"
fi

echo -e "\033[1;31m  Creacion de Snapshot (BTRFS / Snapper) \033[0m"
echo -ne "\033[1;36mIntroduce una descripcion para este snapshot: \033[0m"
read -r DESC

if [[ -z "$DESC" ]]; then
    echo -e "\033[1;31mOperacion cancelada. La descripcion no puede estar vacia.\033[0m"
    exit 1
fi

echo -e "\033[1;36mGenerando snapshot del sistema raiz (/) ...\033[0m"
snapper -c root create -c timeline -d "$DESC"

if [[ $? -eq 0 ]]; then
    echo -e "\033[1;32mSnapshot creado correctamente.\033[0m"
    # Listar los ultimos 3 snapshots para verificacion
    snapper -c root ls | tail -n 4
else
    echo -e "\033[1;31mHubo un error al crear el snapshot.\033[0m"
    exit 1
fi
