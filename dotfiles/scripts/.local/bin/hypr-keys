#!/usr/bin/env bash
# ==============================================================================
# HYPR-KEYS: Visor Interactivo de Atajos de Teclado de Hyprland
# Estética: Ecosistema Spider-Man
# ==============================================================================

# Cargar variables de colores del tema activo
source "$HOME/.config/theme/active.sh" 2>/dev/null
export FZF_DEFAULT_OPTS="
    --layout=reverse
    ${FZF_THEME:---color=\"bg+:#16171f,bg:#0c0d12,spinner:#ff3b5c,hl:#00e5ff\" --color=\"fg:#f8f9fa,header:#ff3b5c,info:#d500f9,pointer:#00e676\" --color=\"marker:#e60026,fg+:#ffffff,prompt:#e60026,hl+:#00e5ff,border:#ff1e43\"}
    --border=rounded --padding=1,2 --margin=2%
    --prompt='  ❯ ' --pointer='' --marker='󰄬'
"


# Buscar primero en la ruta de producción (~/.config/hypr/conf.d/keybinds.conf)
CONFIG_FILE="$HOME/.config/hypr/conf.d/keybinds.conf"

# Si no existe en la ruta de producción, intentar resolver dinámicamente relativa al script
if [[ ! -f "$CONFIG_FILE" ]]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
    # Mapeo al repositorio: scripts/.local/bin -> subir 3 niveles a la raíz del stow pack
    REPO_DIR="$(cd "$SCRIPT_DIR/../../.." &>/dev/null && pwd)"
    if [[ -d "$REPO_DIR/hypr/.config/hypr" ]]; then
        CONFIG_FILE="$REPO_DIR/hypr/.config/hypr/conf.d/keybinds.conf"
    fi
fi

if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "[ERROR] No se encontro el archivo: $CONFIG_FILE"
    read -n 1 -s -r -p "Presiona cualquier tecla para salir..."
    exit 1
fi

RESULT=$(grep -E '^bind' "$CONFIG_FILE" \
    | sed -E 's/^bind[a-z]*\s*=\s*//' \
    | awk -F', ' '{
        mod = $1;
        key = $2;
        action = $3;
        target = "";
        
        for (i=4; i<=NF; i++) {
            target = target (i==4 ? "" : ", ") $i
        }
        
        # Formatear el modificador
        gsub(/\$mainMod/, "SUPER", mod);
        gsub(/SUPER SHIFT/, "SUPER + SHIFT", mod);
        
        if (mod == "") {
            combo = key;
        } else {
            combo = mod " + " key;
        }
        
        # Formatear la accion para que sea User-Friendly
        if (action == "exec") {
            desc = target;
        } else if (action == "workspace") {
            desc = "Ir al Espacio de Trabajo " target;
        } else if (action == "movetoworkspace") {
            desc = "Mover Ventana al Espacio " target;
        } else if (action == "killactive") {
            desc = "Cerrar Ventana";
        } else if (action == "togglefloating") {
            desc = "Ventana Flotante (On/Off)";
        } else if (action == "fullscreen") {
            desc = "Pantalla Completa";
        } else if (action == "exit") {
            desc = "Salir de Hyprland";
        } else if (action == "movefocus") {
            desc = "Mover Foco -> " target;
        } else {
            desc = action " " target;
        }
        
        # Limpiar comandos complejos y variables
        gsub(/\$terminal/, "Terminal", desc);
        gsub(/\$fileManager/, "Gestor de Archivos", desc);
        gsub(/\$menu/, "Lanzador de Apps", desc);
        
        # Reemplazar llamadas especificas con descripciones humanas
        if (desc ~ /hypr-keys/) desc = "Menu de Atajos de Teclado";
        else if (desc ~ /zen-browser/) desc = "Navegador Zen";
        else if (desc ~ /sys-stow/) desc = "Gestor de Despliegue de Dotfiles";
        else if (desc ~ /sys-cam/) desc = "Protector de Privacidad y Gestor de Cámara";
        else if (desc ~ /scratchpad_term/) desc = "Terminal Scratchpad (Flotante)";
        else if (desc ~ /clipse_scratchpad/) desc = "Historial de Portapapeles (Scratchpad)";
        else if (desc ~ /sys-gemini/) desc = "Asistente Gemini AI (Copilot Key)";
        else if (desc ~ /bluetuith/) desc = "Menu de Bluetooth";
        else if (desc ~ /sys-bluetooth/) desc = "Selector Rapido de Bluetooth";
        else if (desc ~ /nmtui/) desc = "Menu de Red / WiFi";
        else if (desc ~ /sys-wifi/) desc = "Selector Rapido de WiFi";
        else if (desc ~ /pulsemixer/) desc = "Menu de Audio";
        else if (desc ~ /sys-audio/) desc = "Selector Rapido de Audio";
        else if (desc ~ /sys-snaps/) desc = "Gestor de Snapshots BTRFS";
        else if (desc ~ /btop/) desc = "Monitor de Sistema";
        else if (desc ~ /clipse/) desc = "Historial de Portapapeles";
        else if (desc ~ /slurp/ && desc ~ /satty/) desc = "Capturar Area de Pantalla";
        else if (desc ~ /satty/) desc = "Capturar Pantalla Completa";
        else if (desc ~ /sys-record/) desc = "Grabar Pantalla (On/Off)";
        else if (desc ~ /sys-update/) desc = "Actualizar Ecosistema Completo";
        else if (desc ~ /sys-health/) desc = "Diagnostico de Servicios del Sistema";
        else if (desc ~ /sys-sunset/) desc = "Filtro Nocturno (On/Off)";
        else if (desc ~ /sys-power-profile/) desc = "Selector de Perfil de Rendimiento";
        else if (desc ~ /sys-power/) desc = "Menu de Energia (Apagar/Reiniciar)";
        else if (desc ~ /sys-share/) desc = "Compartir Archivos en Red";
        else if (desc ~ /sys-secureboot/) desc = "Asistente de Secure Boot";
        else if (desc ~ /sys-spidey/) desc = "Centro de Control del Ecosistema";
        else if (desc ~ /sys-aliases/) desc = "Buscador de Alias de Terminal";
        else if (desc ~ /sys-screenshot.*select/) desc = "Capturar Area de Pantalla";
        else if (desc ~ /sys-screenshot.*full/) desc = "Capturar Pantalla Completa";
        else if (desc ~ /output-volume raise/) desc = "Subir Volumen";
        else if (desc ~ /output-volume lower/) desc = "Bajar Volumen";
        else if (desc ~ /output-volume mute-toggle/) desc = "Mutear Audio";
        else if (desc ~ /brightness raise/) desc = "Subir Brillo";
        else if (desc ~ /brightness lower/) desc = "Bajar Brillo";
        else if (desc ~ /hyprlock/) desc = "Bloquear Pantalla";
        
        # Guardar comando original para ejecución
        if (action == "exec") {
            orig_cmd = target;
        } else {
            orig_cmd = "hyprctl dispatch " action " " target;
        }
        gsub(/\$terminal/, "alacritty", orig_cmd);
        gsub(/\$fileManager/, "alacritty --class floating_tui -e yazi", orig_cmd);
        gsub(/\$menu/, "anyrun", orig_cmd);
        
        # Imprimir delimitado por │ con anchos fijos para alineación limpia
        printf "%-30s │ %-50s │ %s\n", combo, desc, orig_cmd;
    }' \
    | fzf \
        -d '│' \
        --with-nth=1,2 \
        --header="  ATAJO DE TECLADO               ACCION                              (ENTER: Copiar | CTRL-X: Lanzar)" \
        --expect=ctrl-x \
        --info=inline)

if [ -n "$RESULT" ]; then
    KEY=$(echo "$RESULT" | head -n 1)
    LINE=$(echo "$RESULT" | tail -n 1)
    
    if [ -n "$LINE" ]; then
        COMBO=$(echo "$LINE" | cut -d'│' -f1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        DESC=$(echo "$LINE" | cut -d'│' -f2 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        CMD=$(echo "$LINE" | cut -d'│' -f3 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        
        if [ "$KEY" = "ctrl-x" ]; then
            # Lanzar la acción de forma no bloqueante y desligada
            notify-send -t 2000 -i system-run "Lanzando Atajo" "Ejecutando: $DESC"
            eval "$CMD" &>/dev/null & disown
        else
            # Copiar al portapapeles
            echo "$COMBO = $DESC" | wl-copy
            notify-send -t 2000 -i edit-copy "Copiado" "Atajo copiado al portapapeles"
        fi
    fi
fi
