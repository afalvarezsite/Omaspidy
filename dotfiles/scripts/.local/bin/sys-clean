#!/usr/bin/env bash
# sys-clean: Utilidad de mantenimiento y limpieza del sistema.
# Dependencias: pacman, paru, sudo

echo -e "\033[1;31m  Mantenimiento de Arch Linux \033[0m"

# Limpiar cache de Pacman manteniendo las ultimas 2 versiones de los paquetes
if command -v paccache &> /dev/null; then
    echo -e "\033[1;36m-> Limpiando cache de paquetes de Pacman...\033[0m"
    sudo paccache -r -k 2
else
    echo -e "\033[1;33m-> paccache no encontrado. Asegurate de tener pacman-contrib instalado.\033[0m"
fi

# Eliminar paquetes huerfanos de forma interactiva con FZF (Spider-Man themed TUI)
echo -e "\033[1;36m-> Buscando paquetes huerfanos...\033[0m"
ORPHANS=$(pacman -Qtdq)
if [[ -n "$ORPHANS" ]]; then
    if command -v fzf &>/dev/null; then
        echo -e "\033[1;33m-> Se encontraron paquetes huerfanos. Abriendo menu de seleccion con fzf...\033[0m"
        
        # Formatear la lista de huerfanos con sus descripciones
        ORPHANS_WITH_DESC=""
        while read -r pkg; do
            if [[ -n "$pkg" ]]; then
                desc=$(pacman -Qi "$pkg" | grep -E "^(Descripción|Description)" | head -n1 | cut -d':' -f2- | sed 's/^[ \t]*//')
                ORPHANS_WITH_DESC+="$pkg - $desc\n"
            fi
        done <<< "$ORPHANS"
        
        # FZF interactivo
        SELECTED_ORPHANS=$(echo -e "$ORPHANS_WITH_DESC" | grep -v '^$' | fzf \
            --prompt="  Huerfanos a eliminar (TAB para elegir) ❯ " \
            --pointer="" \
            --marker="󰄬" \
            --layout=reverse \
            --border=rounded \
            --margin=2% \
            --padding=1,2 \
            --multi \
            --color="bg+:#16171f,bg:#0c0d12,spinner:#ff3b5c,hl:#00e5ff" \
            --color="fg:#f8f9fa,header:#ff3b5c,info:#d500f9,pointer:#00e676" \
            --color="marker:#e60026,fg+:#ffffff,prompt:#e60026,hl+:#00e5ff,border:#ff1e43" \
            --header="Presiona TAB para seleccionar/deseleccionar multiples. ENTER para eliminar." \
            --info=inline)
            
        if [[ -n "$SELECTED_ORPHANS" ]]; then
            PKGS_TO_REMOVE=$(echo "$SELECTED_ORPHANS" | awk '{print $1}')
            PKGS_TO_REMOVE_ONELINE=$(echo "$PKGS_TO_REMOVE" | tr '\n' ' ' | sed 's/ $//')
            echo -e "\033[1;35mEliminando huerfanos seleccionados: $PKGS_TO_REMOVE_ONELINE\033[0m"
            sudo pacman -Rns $PKGS_TO_REMOVE_ONELINE
        else
            echo -e "\033[1;32mNo se selecciono ningun paquete para eliminar.\033[0m"
        fi
    else
        echo -e "\033[1;35mEliminando todos los huerfanos de forma automatica: $ORPHANS\033[0m"
        sudo pacman -Rns $ORPHANS
    fi
else
    echo -e "\033[1;32mNo se encontraron paquetes huerfanos.\033[0m"
fi

# Limpiar cache de Paru/Yay (AUR)
if command -v paru &> /dev/null; then
    echo -e "\033[1;36m-> Limpiando cache de AUR (paru)...\033[0m"
    paru -Sc --noconfirm
fi

# Vaciar cachés de usuario residuales de ~/.cache que suelen engordar mucho (Corregido comodin)
echo -e "\033[1;36m-> Vaciando ~/.cache/thumbnails...\033[0m"
rm -rf "$HOME/.cache/thumbnails/"*
echo -e "\033[1;36m-> Vaciando carpetas temporales de yay/paru...\033[0m"
rm -rf "$HOME/.cache/paru/clone/"*
rm -rf "$HOME/.cache/yay/"*

echo -e "\033[1;31m  Mantenimiento Completado \033[0m"
